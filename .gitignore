# Local environment.
.env

# Node
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
# ...but keep the shared workspace config (test discovery, run tasks)
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo

# Data
# Attachments and other things a running editor keeps beside the project.
/data/
*.log

# AI credentials written by ⚙ Settings → Keys and addresses. Its default location
# is the working directory, which for a dev run is this repo -- never commit it.
ai-settings.json

# Local editor/agent scratch, not part of the project.
.claude/

# What a session of a graph keeps beside it: never deployed, gone after a reset.
state.json
*.state.json

# The downloadable package, built by scripts/package.mjs.
tell-and-wire*.zip

# What an example's end point writes when one is run from the repository or from a workspace folder.
/output/
/backend/output/

# What tests leave in backend/ when they are stopped halfway: scratch files, hidden so that no scan of the sources looks into them.
/backend/.tell-and-wire-listing-*
/backend/.confine-probe-link
/backend/.sandbox-probe-*
