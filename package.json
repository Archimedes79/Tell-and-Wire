{
  "name": "tell-and-wire",
  "private": true,
  "description": "Tell & Wire: a visual node editor for AI workflows and small local tools. Say in plain words what each node should do, wire the nodes into a graph, give it a GUI, and run it offline with a local model. Source-available, free for noncommercial use.",
  "keywords": [
    "visual-programming",
    "node-editor",
    "no-code",
    "low-code",
    "ai-workflows",
    "workflow-automation",
    "local-llm",
    "local-first",
    "offline",
    "mcp",
    "model-context-protocol",
    "source-available"
  ],
  "homepage": "https://github.com/Archimedes79/Tell-and-Wire#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Archimedes79/Tell-and-Wire.git"
  },
  "bugs": {
    "url": "https://github.com/Archimedes79/Tell-and-Wire/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "graph",
    "gui",
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "node backend/cli/main.ts --editor frontend/dist",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace frontend",
    "build:notebook": "npm run build:notebook --workspace frontend",
    "start:notebook": "node scripts/start-notebook.mjs",
    "package:notebook": "npm run build:notebook && node scripts/package-notebook.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspace frontend && eslint graph gui backend --ext ts --no-eslintrc -c .eslintrc.node.cjs --report-unused-disable-directives --max-warnings 0",
    "licenses": "node scripts/licenses.mjs"
  }
}
