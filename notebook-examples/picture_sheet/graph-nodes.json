{
  "sheet": {
    "kind": "start",
    "label": "Look at a folder"
  },
  "sheet_pictures": {
    "kind": "code",
    "label": "Pictures",
    "description": "Hand on every picture of \"Folder\" as it is.",
    "config": {
      "batch_concurrency": 3,
      "batch_mode": "per_item",
      "window": {
        "id": "sheet",
        "title": "Look at a folder",
        "span": 16,
        "rows": 8,
        "page": {
          "name": "Picture sheet",
          "columns": 16,
          "cell": 56,
          "gap": 14
        },
        "shows": [
          {
            "output": "Pictures",
            "kind": "image",
            "result": "Pictures",
            "cells": 10,
            "rows": 4,
            "width": 640,
            "height": 224
          }
        ],
        "scheme": {
          "id": "white",
          "light": true,
          "background": "#f4f5f7",
          "surface": "#ffffff",
          "line": "#d8dbe0",
          "text": "#1a1d23",
          "muted": "#4a515c",
          "accent": "#2563eb",
          "success": "#15803d",
          "danger": "#b42318",
          "warning": "#b45309",
          "series": [
            "#2563eb",
            "#15803d",
            "#b45309",
            "#be185d",
            "#0e7490",
            "#6d28d9",
            "#4d7c0f",
            "#c2410c"
          ]
        }
      }
    },
    "inputs": [
      {
        "port": "folder",
        "name": "Folder",
        "type": "file_path",
        "list": true,
        "description": "What goes into Folder",
        "field": "sheet_in_folder"
      }
    ],
    "outputs": [
      {
        "port": "pictures",
        "name": "Pictures",
        "type": "text",
        "list": true
      }
    ]
  },
  "sheet_captions": {
    "kind": "ai",
    "label": "Captions",
    "description": "Describe \"Folder\" in one short sentence.",
    "config": {
      "batch_concurrency": 3,
      "batch_mode": "per_item"
    },
    "inputs": [
      {
        "port": "folder",
        "name": "Folder",
        "type": "file_path",
        "list": true,
        "description": "What goes into Folder",
        "field": "sheet_in_folder"
      }
    ],
    "outputs": [
      {
        "port": "output",
        "name": "Captions",
        "type": "text",
        "list": true
      }
    ]
  },
  "sheet_out_pictures": {
    "kind": "end",
    "label": "Pictures",
    "inputs": [
      {
        "port": "value",
        "name": "Value",
        "type": "any",
        "list": true
      }
    ]
  },
  "sheet_out_captions": {
    "kind": "end",
    "label": "Captions",
    "inputs": [
      {
        "port": "value",
        "name": "Value",
        "type": "any",
        "list": true
      }
    ]
  }
}
