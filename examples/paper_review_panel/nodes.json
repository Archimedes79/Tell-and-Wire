      {
        "port": "path",
        "name": "Path",
        "type": "file_path",
        "description": "Optional: a wired file or folder path, used instead of the one set above."
      }
    ]
  },
  "claims_review": {
    "kind": "end",
    "label": "Evidence & claims reviewer",
    "inputs": [
      {
        "port": "value",
        "name": "Value",
        "type": "any"
      },
      {
        "port": "path",
        "name": "Path",
        "type": "file_path",
        "description": "Optional: a wired file or folder path, used instead of the one set above."
      }
    ]
  },
  "references_review": {
    "kind": "end",
    "label": "References reviewer",
    "inputs": [
      {
        "port": "value",
        "name": "Value",
        "type": "any"
      },
      {
        "port": "path",
        "name": "Path",
        "type": "file_path",
        "description": "Optional: a wired file or folder path, used instead of the one set above."
      }
    ]
  },
  "figures_review": {
