{
  "name": "Paper review panel",
  "description": "A pre-submission review panel: five AI reviewers — scientific soundness, an adversarial referee, evidence and claims, references, figures and tables — read the same manuscript in parallel, and a judge consolidates their findings into one ranked list with a recommendation. The AI advises; the researcher decides. The sample paper is fictional and has problems planted in it.",
  "nodes": {
    "review": "start",
    "read": "code",
    "scientific": "ai",
    "adversarial": "ai",
    "claims": "ai",
    "references": "ai",
    "figures": "ai",
    "judge": "ai",
    "verdict": "end",
    "scientific_review": "end",
    "adversarial_review": "end",
    "claims_review": "end",
    "references_review": "end",
    "figures_review": "end"
  },
  "wires": [
    "review.data -> read.file",
    "read.text -> scientific.paper",
    "scientific.output -> judge.scientific",
    "scientific.output -> scientific_review.value",
    "read.text -> adversarial.paper",
    "adversarial.output -> judge.adversarial",
    "adversarial.output -> adversarial_review.value",
    "read.text -> claims.paper",
    "claims.output -> judge.claims",
    "claims.output -> claims_review.value",
    "read.text -> references.paper",
    "references.output -> judge.references",
    "references.output -> references_review.value",
    "read.text -> figures.paper",
    "figures.output -> judge.figures",
    "figures.output -> figures_review.value",
    "judge.output -> verdict.value"
  ]
}
